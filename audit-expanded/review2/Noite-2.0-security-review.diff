+def test_history_credentials_are_redacted_at_model_boundary_but_preserved_in_sqlite(
+    tmp_path, monkeypatch
+):
+    from noite import assistant as assistant_module
+    from noite.store import add_message
+
+    assistant = AssistantService(Settings(_env_file=None, data_dir=tmp_path))
+    secret = "synthetic-history-secret-unique-73921"
+    current_secret = "synthetic-current-input-key-28491"
+    with open_database(assistant.database_path) as connection:
+        add_message(connection, "user", f"DATABASE_URL=postgres://user:{secret}@db/app")
+        add_message(connection, "assistant", f"Earlier token: {secret}")
+        original_rows = connection.execute(
+            "SELECT id, created_at, role, content FROM messages ORDER BY id"
+        ).fetchall()
+    captured = {}
+
+    async def fake_model(prompt, *, messages=None, model=None):
+        captured["prompt"] = prompt
+        captured["messages"] = messages
+        return "ok"
+
+    monkeypatch.setattr(assistant_module, "ask_local_model", fake_model)
+    project_root = tmp_path / "project"
+    project_root.mkdir()
+    (project_root / "database_settings.py").write_text(
+        'DATABASE_URL="postgres://db/app?password=synthetic-project-password"\n',
+        encoding="utf-8",
+    )
+    asyncio.run(
+        assistant.respond(
+            f"explique banco dados API_KEY={current_secret}", project_root=project_root
+        )
+    )
+
+    assert all(secret not in message["content"] for message in captured["messages"])
+    assert all(current_secret not in message["content"] for message in captured["messages"])
+    assert current_secret not in captured["prompt"]
+    assert all(
+        "synthetic-project-password" not in message["content"]
+        for message in captured["messages"]
+    )
+    with open_database(assistant.database_path) as connection:
+        after_rows = connection.execute(
+            "SELECT id, created_at, role, content FROM messages ORDER BY id"
+        ).fetchall()
+    assert after_rows[: len(original_rows)] == original_rows
+    assert secret in "\n".join(row[3] for row in original_rows)
+
+
