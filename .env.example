NOITE_OFF_GRID=true
NOITE_LOCAL_MODEL=qwen2.5:3b
NOITE_VISION_MODEL=qwen2.5vl:3b
NOITE_OLLAMA_BASE_URL=http://127.0.0.1:11434
NOITE_MODEL_TIMEOUT_SECONDS=180
NOITE_WORKSPACE_DIR=
NOITE_ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=
# Google AI Studio: configure sua chave no ambiente local, nunca no frontend.
GEMINI_API_KEY=
NOITE_GEMINI_MODEL=gemini/gemini-3.8-flash
NOITE_GLM_ENABLED=false
NOITE_GLM_MODEL=zai/glm-5.3-flash
NOITE_GLM_API_MODE=general
NOITE_GLM_TIMEOUT_SECONDS=60
NOITE_GLM_MAX_RETRIES=1
# Categorias permitidas para envio ao GLM, separadas por vírgula. Vazio mantém tudo local.
NOITE_GLM_TASK_CATEGORIES=
ZAI_API_KEY=
# Obrigatório para o servidor MCP HTTP local. Mantenha este token privado.
NOITE_MCP_AUTH_TOKEN=
NOITE_MCP_PORT=8767
