def safe_call(func, *args, fallback=None, **kwargs):
   try:
      return func(*args, **kwargs)
   except Exception as e:
      print(f"[Erro em {func.__name__}]: {e}")
      return fallback

try:
   orq = Orchestrator()
   print("[OK] Orchestrator carregado")

except Exception as e:
   print(f"[ERRO] Orchestrator: {e}")
   orq = None

SAMPLE_RATE = 16000
PALAVRAS_ATIVACAO = ["mote", "moite", "noite", "monte", "note", "ativar",

                 "boa noite", "olá note", "ei note", "oi note"]

try:
   modelo = Model("model")
   recognizer = KaldiRecognizer(modelo, SAMPLE_RATE)
   print("[OK] Modelo Vosk carregado")

except Exception as e:
   print(f"[ERRO] Modelo Vosk: {e}")
   exit(1)

q = queue.Queue()

def callback(indata, frames, time, status):
   try:
      q.put(bytes(indata))
   except Exception:
      pass

async def _gerar_audio(texto, nome_arquivo):
   try:
      comunicador = edge_tts.Communicate(texto, voice="pt-BR-AntonioNeural")
      await comunicador.save(nome_arquivo)
      return True
   except Exception as e:
print(f"[Erro TTS]: {e}")
return False

def falar(texto):                                                          fallback=False)
   if not texto or not texto.strip():
      return
   print(f"Note: {texto}")
   try:
      nome_arquivo = f"temp/resposta_{int(time.time() * 1000)}.mp3"
      os.makedirs("temp", exist_ok=True)
      sucesso = safe_call(asyncio.run, _gerar_audio(texto, nome_arquivo),
      if not sucesso:
          return
      if os.path.exists(nome_arquivo):
          try:
             playsound(nome_arquivo)
          except Exception as e:
             print(f"[Erro playsound]: {e}")
   except Exception as e:
      print(f"[Erro falar]: {e}")
   finally:
      try:
          if 'nome_arquivo' in locals() and os.path.exists(nome_arquivo):
             os.remove(nome_arquivo)
      except Exception:
          pass

def corrigir_palavra(palavra):
   """Corrige UMA palavra baseado em padrões fonéticos"""
   if not palavra:
      return palavra

   p = palavra.strip(".,!?;:")
   p_lower = p.lower()

   # ===== VERBOS DE ABRIR =====
   if re.match(r'^(abr|avr|abri|abriu|abril|abirr|abrí)', p_lower):

      return "abra" if not p_lower.endswith(("r", "iu")) else "abrir"

   # ===== PESQUISAR =====
   if re.match(r'^(pesqui|pesquise|pesquisa|pesquis|pesquiss|peski|peskisa|pezquisa|pequisa|peskiza|puxa)',
p_lower):

      return "pesquise"

   # ===== PROCURAR =====
   if re.match(r'^(prokur|procure|procura|procu|prócura)', p_lower):

      return "procure"

   # ===== BUSCAR =====
   if re.match(r'^(busk|busca|busque|buski|buc|búusca)', p_lower):

      return "busca"

   # ===== TOCAR =====
   if re.match(r'^(tok|toca|toke|tocar|tóca)', p_lower):

      return "toca"

   # ===== YOUTUBE =====
   if re.match(r'^(iutub|ioutube|youtub|youtube|yutub|yatube|ióutube|rútube|rutube|youtube)', p_lower):
      return "youtube"

   # ===== GOOGLE =====
   if re.match(r'^(gugol|gogle|googl|gooogle|guugel|gúgou|google)', p_lower):

      return "google"

   # ===== LISTAR =====
   if re.match(r'^(list|lista|liste|listar|lísta)', p_lower):

      return "lista"

   # ===== MOSTRAR =====
   if re.match(r'^(mostr|mostra|moste|mostre|móstra)', p_lower):

      return "mostra"

   # ===== MARCAR =====
   if re.match(r'^(marc|marca|marque|márca)', p_lower):

      return "marque"

   # ===== AGENDAR =====
   if re.match(r'^(ajend|agend|agende|ajende|ajénda)', p_lower):

      return "agende"

   # ===== LEMBRAR =====
   if re.match(r'^(lembr|lembre|lembra|lémbre|lemb|lémbra)', p_lower):

      return "lembre"

   # ===== ANOTAR =====
   if re.match(r'^(anota|anot|anote|anóta)', p_lower):

      return "anota"

   # ===== GUARDAR =====
   if re.match(r'^(guard|guarda|guarde|guárda)', p_lower):

      return "guarda"

   # ===== CHROMA =====
   if re.match(r'^(crom|krom|cromo|croma|cróma)', p_lower):

      return "chroma"

   # ===== ARQUIVO =====
   if re.match(r'^(arki|arqui|arquiv|arkivo|arquivo|árquivo)', p_lower):

      return "arquivo"

   # ===== COMPUTADOR / PC =====
   if re.match(r'^(comput|computad|pc|piq)', p_lower):

      return "computador"

   # ===== WAKE WORD ERRADA =====
   if p_lower == "noites" or p_lower == "noytes" or p_lower == "noiti":

      return "noite"

   return p

def corrigir_texto(texto):
   """Corrige o texto inteiro palavra por palavra"""
   if not texto:
      return texto

   palavras = texto.split()
   corrigidas = []
for palavra in palavras:
   pontuacao = ""
   p_limpa = palavra
   if p_limpa and p_limpa[-1] in ".,!?;:":
      pontuacao = p_limpa[-1]
      p_limpa = p_limpa[:-1]

   corrigida = corrigir_palavra(p_limpa)
   corrigidas.append(corrigida + pontuacao)

return ' '.join(corrigidas)

def limpar_query(query):
   """Remove verbo de busca que ficou colado no início da query"""
   return re.sub(r'^(pesquis\w*|busc\w*|procur\w*|toc\w*|most\w*)\s+', '', query,

flags=re.IGNORECASE).strip()

# ===== DETECÇÃO DE SITES CONHECIDOS =====
SITES_CONHECIDOS = [

   "youtube", "google", "gmail", "github", "chatgpt", "maps",
   "facebook", "instagram", "twitter", "tiktok", "whatsapp",
   "linkedin", "reddit", "amazon", "mercadolivre", "netflix",
   "spotify", "twitch", "discord", "telegram", "drive"
]

APPS_CONHECIDOS = [
   "chrome", "firefox", "edge", "explorer", "calculadora",
   "notepad", "word", "excel", "powerpoint", "outlook",
   "vscode", "visual studio", "pycharm", "terminal", "cmd"

]

def parece_site_ou_app(texto):                conhecido"""
   """Verifica se o texto contém um site/app
   texto_lower = texto.lower()
   for site in SITES_CONHECIDOS:
      if site in texto_lower:
          return "site", site
   for app in APPS_CONHECIDOS:
      if app in texto_lower:
          return "app", app
   return None, None

def extrair_comando(texto):
   """Remove a wake word e retorna o resto"""
   try:
      texto = texto.lower().strip()
      for palavra in PALAVRAS_ATIVACAO:
          if palavra in texto:
             partes = texto.split(palavra, 1)
             return partes[1].strip() if len(partes) > 1 else ""
      return texto
   except Exception as e:
      print(f"[Erro extrair_comando]: {e}")
      return ""
def detectar_acao_rapida(comando):
   """Detecta ação sem chamar o llama"""
   if not comando:
      return None

   try:
      cmd = comando.lower().strip()
      # Remove palavras de preenchimento
      cmd = re.sub(r'\b(por favor|pra mim|ai|ái|pfv)\b', '', cmd).strip()

      # ===== PRÉ-PROCESSAMENTO: detectar intenção de PESQUISA COM SITE =====
      # "pesquise X no youtube", "pesquise por X no youtube", "X no youtube"
      match = re.search(r'(?:pesquise|pesquisa|pesquisar|procure|procura|busca|busque|toca|tocar|me
mostra)\s+(?:por|sobre)?\s*(.+?)\s+no\s+(youtube|google)\b', cmd)
      if match:

          query = match.group(1).strip()
          site = match.group(2).strip()
          query = re.sub(r'\s+(pra mim|por favor|ai|ái)$', '', query).strip()
          query = limpar_query(query)
          if query and site in ["youtube", "google"]:

             return {"acao": "pesquisar", "site": site, "query": query}

      # "no youtube pesquise X", "no youtube X", "youtube pesquise X"
      match =
re.search(r'no\s+(youtube|google)\s+(?:pesquise|pesquisa|pesquisar|procure|procura|busca|busque|toca)?\s
*(?:por|sobre)?\s*(.+)', cmd)
      if match:

          site = match.group(1).strip()
          query = match.group(2).strip()
          query = re.sub(r'\s+(pra mim|por favor|ai|ái)$', '', query).strip()
          query = limpar_query(query)
          if query:

             return {"acao": "pesquisar", "site": site, "query": query}

      # "youtube pesquise X" ou "youtube X"
      match =
re.search(r'(youtube|google)\s+(?:pesquise|pesquisa|pesquisar|procure|procura|busca|busque|toca|me
mostra)?\s*(?:por|sobre)?\s*(.+)', cmd)
      if match:

          site = match.group(1).strip()
          query = match.group(2).strip()
          query = re.sub(r'\s+(pra mim|por favor|ai|ái)$', '', query).strip()
          query = limpar_query(query)
          if query:

             return {"acao": "pesquisar", "site": site, "query": query}

      # ===== PESQUISAR LOCAL (PC) =====
      match =
re.search(r'\b(pesquise|pesquisa|busca|procura)\s+(?:nos\s+|no\s+)?(?:meus\s+)?(?:arquivos?|pc|computad
or)\s+(.+)', cmd)
      if match:

          query = match.group(2).strip()
          query = limpar_query(query)
          if query:

             return {"acao": "pesquisar", "site": "local", "query": query}

      # ===== ABRIR ARQUIVO ESPECÍFICO (com extensão) =====
      match = re.search(r'\b(abre|abrir|abre o)\s+(?:o\s+)?(?:arquivo\s+)?([\w\-./\\]+\.\w+)', cmd)
      if match:
          caminho = match.group(2).strip()
          if '/' in caminho or '\\' in caminho or caminho.endswith(('.py', '.txt', '.md', '.json', '.csv', '.pdf', '.docx',
'.xlsx', '.html', '.js', '.css', '.ipynb')):

             return {"acao": "abrir_arquivo", "caminho": caminho}

      # ===== ABRIR SITE/APP (genérico) =====
      match = re.search(r'\b(abra|abre|abrir|vai no|entra no|abre o|abre ai|abre
aí)\s+(?:o|a|os|as|em|no|na)?\s*(.+)', cmd)
      if match:

          alvo = match.group(2).strip()
          alvo = re.sub(r'^(e|ou|de)\s+', '', alvo).strip()
          alvo = re.sub(r'\s+(pra mim|por favor|ai|ái)$', '', alvo).strip()
          if alvo and len(alvo) > 1:

             tipo, _ = parece_site_ou_app(alvo)
             if tipo:

                return {"acao": "abrir", "alvo": alvo}
             if not re.search(r'\b(pesquise|pesquisa|busca|procura|toca)\b', alvo):

                return {"acao": "abrir", "alvo": alvo}

      # ===== PESQUISAR padrão (google) =====
      match =
re.search(r'\b(pesquise|pesquisa|pesquisar|procure|procura|busca|busque)\s+(?:por|sobre)?\s*(.+)', cmd)
      if match:

          query = match.group(2).strip()
          query = re.sub(r'\s+(pra mim|por favor|ai|ái|no youtube|no google)$', '', query).strip()
          query = limpar_query(query)
          if query and not query.startswith("arquivo"):

             return {"acao": "pesquisar", "site": "google", "query": query}

      # ===== BUSCAR ARQUIVO =====
      match = re.search(r'\b(busca|procure|procura|encontra|acha)\s+(?:arquivo\s+)?(?:sobre|de|com|que
tenha|com tema|sobre)\s+(.+)', cmd)
      if match:

          query = match.group(2).strip()
          if query:

             return {"acao": "buscar_arquivo", "query": query}

      # ===== LISTAR ARQUIVOS =====
      match = re.search(r'\b(lista|mostra|liste|mostre)\s+(?:os\s+)?(?:arquivos|pastas|arquivos da
pasta|arquivos do)(?:\s+(.+))?', cmd)
      if match:

          resto = (match.group(2) or "").strip()
          caminho = "."
          extensao = None
          caminho_match = re.search(r'(?:da pasta|de|do|em)\s+([\w/\\]+)', resto)
          if caminho_match:

             caminho = caminho_match.group(1).strip()
          ext_match = re.search(r'\.(py|txt|md|json|csv|pdf|docx?|xlsx?|html|js|css)$', resto)
          if ext_match:

             extensao = "." + ext_match.group(1)
          return {"acao": "listar_arquivos", "caminho": caminho, "extensao": extensao}

      # ===== MARCAR EVENTO =====
      match = re.search(r'\b(marque|marca|agende|agendar|anota na agenda|coloca na agenda|cria um
evento)\s+(.+)', cmd)
      if match:

          return {"acao": "criar_evento", "descricao": match.group(2).strip(), "data_hora": "2026-06-11 20:00"}

      # ===== LEMBRAR =====
      match = re.search(r'\b(lembre|lembrar|lembra|anota|guarda|salva)\s+(.+)', cmd)
      if match:
          fato = match.group(2).strip()
          permanente = any(p in cmd for p in ["para sempre", "nunca esqueça", "sempre", "permanente"])
          return {"acao": "lembrar", "fato": fato, "permanente": permanente}

      # ===== LISTAR EVENTOS =====
      if re.search(r'\b(o que (tenho|tenho marcado|tá marcado|esta marcado)|meus eventos|minha agenda|o
que tem marcado)\b', cmd):

          return {"acao": "listar_eventos"}

      # ===== REINDEXAR =====
      if re.search(r'\b(reindexa|indexa|reindexar|indexar)\b', cmd):

          return {"acao": "reindexar"}

      return None
   except Exception as e:

      print(f"[Erro detectar_acao]: {e}")
      return None

def eh_comando_direto(texto):
   """Retorna True se o texto for um comando de ação sem wake word"""
   try:
      if not texto:
          return False
      return detectar_acao_rapida(texto) is not None
   except Exception as e:
      print(f"[Erro eh_comando_direto]: {e}")
      return False

