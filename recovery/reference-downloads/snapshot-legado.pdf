import re

def corrigir_palavra(palavra):
   if not palavra:
      return palavra
   p = palavra.strip(".,!?;:")
   p_lower = p.lower()

   if re.match(r'^(abr|avr|abri|abriu|abril|abirr|abrí)', p_lower):
      return "abra" if not p_lower.endswith(("r", "iu")) else "abrir"

   if re.match(r'^(pesqui|pesquise|pesquisa|pesquis|pesquiss|peski|peskisa|pezquisa|pequisa|peskiza|puxa)',
p_lower):

      return "pesquise"
   if re.match(r'^(prokur|procure|procura|procu)', p_lower):

      return "procure"
   if re.match(r'^(busk|busca|busque|buski|buc)', p_lower):

      return "busca"
   if re.match(r'^(tok|toca|toke|tocar)', p_lower):

      return "toca"
   if re.match(r'^(iutub|ioutube|youtub|youtube|yutub|yatube|rutube)', p_lower):

      return "youtube"
   if re.match(r'^(gugol|gogle|googl|gooogle|guugel)', p_lower):

      return "google"
   if re.match(r'^(list|lista|liste|listar)', p_lower):

      return "lista"
   if re.match(r'^(mostr|mostra|moste|mostre)', p_lower):

      return "mostra"
   if re.match(r'^(marc|marca|marque)', p_lower):

      return "marque"
   if re.match(r'^(ajend|agend|agende|ajende)', p_lower):

      return "agende"
   if re.match(r'^(lembr|lembre|lembra)', p_lower):

      return "lembre"
   if re.match(r'^(anota|anot|anote)', p_lower):

      return "anota"
   if re.match(r'^(guard|guarda|guarde)', p_lower):

      return "guarda"
   if re.match(r'^(crom|krom|cromo|croma)', p_lower):

      return "chroma"
   if re.match(r'^(arki|arqui|arquiv|arkivo|arquivo)', p_lower):

      return "arquivo"
   if p_lower in ["noites", "noytes", "noiti"]:

      return "noite"
   return p

def corrigir_texto(texto):
   if not texto:
      return texto
   palavras = texto.split()
   corrigidas = []
   for palavra in palavras:
      pontuacao = ""
      p_limpa = palavra
      if p_limpa and p_limpa[-1] in ".,!?;:":

          pontuacao = p_limpa[-1]
          p_limpa = p_limpa[:-1]
      corrigida = corrigir_palavra(p_limpa)
      corrigidas.append(corrigida + pontuacao)
   return ' '.join(corrigidas)

def rounded_rect(canvas, x1, y1, x2, y2, raio=22, **kwargs):
   pontos = [
      x1 + raio, y1, x2 - raio, y1, x2, y1, x2, y1 + raio,
      x2, y2 - raio, x2, y2, x2 - raio, y2, x1 + raio, y2,
      x1, y2, x1, y2 - raio, x1, y1 + raio, x1, y1,
   ]
   return canvas.create_polygon(pontos, smooth=True, **kwargs)

def abrir_janela():
   janela = tk.Tk()
   janela.title("")
   janela.overrideredirect(True)
   janela.attributes("-topmost", True)
   janela.configure(bg=COR_TRANSPARENTE)
   janela.attributes("-transparentcolor", COR_TRANSPARENTE)

   largura = 620
   altura_atual = 64
   altura_max = 420
   x = (janela.winfo_screenwidth() // 2) - (largura // 2)
   y = janela.winfo_screenheight() - 460

   janela.geometry(f"{largura}x{altura_atual}+{x}+{y}")

   canvas = tk.Canvas(janela, width=largura, height=altura_atual,
                    bg=COR_TRANSPARENTE, highlightthickness=0)

   canvas.pack(fill="both", expand=True)

   def desenhar(altura):
      canvas.delete("fundo")
      canvas.config(height=altura)
      rounded_rect(canvas, 2, 2, largura - 2, altura - 2,
                 raio=22, fill=COR_FUNDO, outline="", tags="fundo")
      canvas.tag_lower("fundo")

   desenhar(altura_atual)

   # ===== DRAG DA JANELA =====
   _drag_data = {"x": 0, "y": 0}

   def iniciar_drag(event):
      _drag_data["x"] = event.x
      _drag_data["y"] = event.y

   def arrastar(event):
      novo_x = janela.winfo_x() + (event.x - _drag_data["x"])
      novo_y = janela.winfo_y() + (event.y - _drag_data["y"])
      janela.geometry(f"+{novo_x}+{novo_y}")
canvas.bind("<ButtonPress-1>", iniciar_drag)
canvas.bind("<B1-Motion>", arrastar)

# ===== CAMPO DE ENTRADA =====
entrada = tk.Entry(

   canvas,
   font=FONTE,
   bg=COR_FUNDO,
   fg=COR_PLACEHOLDER,
   insertbackground=COR_TEXTO,
   relief="flat",
   bd=0,
   disabledbackground=COR_FUNDO,
   disabledforeground=COR_PLACEHOLDER,
   highlightthickness=0
)
entrada.insert(0, PLACEHOLDER)
entrada_id = canvas.create_window((largura - 80) // 2, 32, window=entrada, width=largura - 130)

def ao_focar(event):
   if entrada.get() == PLACEHOLDER:
      entrada.delete(0, "end")
      entrada.config(fg=COR_TEXTO)

def ao_desfocar(event):
   if entrada.get().strip() == "":
      entrada.insert(0, PLACEHOLDER)
      entrada.config(fg=COR_PLACEHOLDER)

entrada.bind("<FocusIn>", ao_focar)
entrada.bind("<FocusOut>", ao_desfocar)
entrada.focus_force()

