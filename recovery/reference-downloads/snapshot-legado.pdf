botao_y = 32
botao_raio = 18

def desenhar_mic(cor):
   nonlocal mic_oval, mic_texto_id
   canvas.delete("mic")
   # Círculo de fundo
   mic_oval = canvas.create_oval(
      botao_x - botao_raio, botao_y - botao_raio,
      botao_x + botao_raio, botao_y + botao_raio,
      fill=cor, outline="", tags="mic"

 🎤 )

   # Ícone do microfone ( )
   mic_texto_id = canvas.create_text(

  🎤 botao_x, botao_y,

      text=" " if not gravando[0] else "■",
      fill="#ffffff",
      font=FONTE_MIC,
   tags="mic"
)

def ao_clicar_mic(event=None):
   if not mic_ativo[0] or processando_audio[0]:
      return
   if not gravando[0]:
      iniciar_gravacao()
   else:
      parar_gravacao()

def ao_passar_mic(event=None):
   if mic_ativo[0] and not gravando[0] and not processando_audio[0]:
      canvas.itemconfig(mic_oval, fill=COR_BOTAO_HOVER)

def ao_sair_mic(event=None):
   if not gravando[0] and not processando_audio[0]:
      cor = COR_MIC_NORMAL if mic_ativo[0] else "#555555"
      canvas.itemconfig(mic_oval, fill=cor)

canvas.tag_bind("mic", "<Button-1>", ao_clicar_mic)
canvas.tag_bind("mic", "<Enter>", ao_passar_mic)
canvas.tag_bind("mic", "<Leave>", ao_sair_mic)

if VOSK_OK:
   desenhar_mic(COR_MIC_NORMAL)

else:
   desenhar_mic("#555555")

# ===== GRAVAÇÃO DE ÁUDIO =====
audio_queue = queue.Queue()
gravacao_finalizada = threading.Event()
audio_data = []

def callback_mic(indata, frames, time_info, status):
   if gravando[0]:
      audio_queue.put(bytes(indata))

def gravar_audio():
   """Grava por 5 segundos ou até clicar de novo"""
   recognizer_local = KaldiRecognizer(modelo_vosk, SAMPLE_RATE)
   texto_final = ""
   inicio = time.time()
   silencio_inicio = None
   TEMPO_MAX = 15.0 # máximo 15 segundos
   SILENCIO_FIM = 3.0 # 3s de silêncio = fim

with sd.RawInputStream(samplerate=SAMPLE_RATE, blocksize=8000,        dtype='int16',
                    channels=1, callback=callback_mic):

   while gravando[0] and (time.time() - inicio) < TEMPO_MAX:
      try:
          data = audio_queue.get(timeout=0.1)
          if recognizer_local.AcceptWaveform(data):
             resultado = json.loads(recognizer_local.Result())
             fragmento = resultado.get("text", "").strip()
             if fragmento:
                texto_final = fragmento
                silencio_inicio = None
          else:
             # Verifica silêncio (partial vazio)
                parcial = json.loads(recognizer_local.PartialResult())
                if not parcial.get("partial", "").strip():

                    if silencio_inicio is None:
                       silencio_inicio = time.time()

                    elif time.time() - silencio_inicio > SILENCIO_FIM:
                       break

                else:
                    silencio_inicio = None

          except queue.Empty:
             pass

   # Pega último resultado
   resultado = json.loads(recognizer_local.FinalResult())
   if resultado.get("text", "").strip():

      texto_final = resultado["text"].strip()

   gravacao_finalizada.set()
   return texto_final

def iniciar_gravacao():
   gravando[0] = True
   gravacao_finalizada.clear()
   # Limpa a fila
   while not audio_queue.empty():
      try:
          audio_queue.get_nowait()
      except queue.Empty:
          break
   desenhar_mic(COR_MIC_GRAVANDO)
   entrada.config(state="normal")
   if entrada.get() == PLACEHOLDER:
      entrada.delete(0, "end")
      entrada.config(fg=COR_TEXTO)

   # Thread de gravação
   def worker():

      texto = gravar_audio()
      janela.after(0, lambda: finalizar_gravacao(texto))

   threading.Thread(target=worker, daemon=True).start()

def parar_gravacao():
   gravando[0] = False

def finalizar_gravacao(texto):
   gravando[0] = False
   processando_audio[0] = True
   desenhar_mic(COR_MIC_PROCESSANDO)

   if texto:
      # Aplica corretor
      texto_corrigido = corrigir_texto(texto.lower())
      print(f"[Microfone] Original: {texto}")
      print(f"[Microfone] Corrigido: {texto_corrigido}")

      entrada.delete(0, "end")
      entrada.insert(0, texto_corrigido)
      entrada.config(fg=COR_TEXTO)
      entrada.focus_force()
   else:
      entrada.delete(0, "end")
      entrada.insert(0, "(nada detectado)")
      entrada.config(fg=COR_PLACEHOLDER)

   # Volta ao normal após 500ms
   janela.after(500, lambda: voltar_mic_normal())

def voltar_mic_normal():
   processando_audio[0] = False
   if VOSK_OK:
      desenhar_mic(COR_MIC_NORMAL)
   else:
      desenhar_mic("#555555")

# ===== ÁREA DE RESPOSTA =====
frame_resposta = tk.Frame(canvas, bg=COR_FUNDO)

texto_resposta = tk.Text(
   frame_resposta,
   font=FONTE_RESPOSTA,
   bg=COR_FUNDO,
   fg=COR_RESPOSTA,
   relief="flat",
   bd=0,
   wrap="word",
   highlightthickness=0,
   padx=4,
   pady=4

)
scrollbar = tk.Scrollbar(frame_resposta, command=texto_resposta.yview,

                     bg=COR_FUNDO, troughcolor=COR_FUNDO)
texto_resposta.config(yscrollcommand=scrollbar.set)

texto_resposta.pack(side="left", fill="both", expand=True)
scrollbar.pack(side="right", fill="y")

resposta_window_id = None

def fechar(event=None):
   gravando[0] = False
   janela.destroy()

def digitar_texto(texto, indice=0):
   if indice == 0:
      texto_resposta.config(state="normal")
      texto_resposta.delete("1.0", "end")

   if indice < len(texto):
      texto_resposta.insert("end", texto[indice])
      texto_resposta.see("end")
      janela.after(15, lambda: digitar_texto(texto, indice + 1))

   else:
      texto_resposta.config(state="disabled")
      entrada.config(state="normal")
      entrada.delete(0, "end")
      entrada.focus_force()

def mostrar_resposta(resposta):
   nonlocal resposta_window_id
   nova_altura = min(altura_max, 90 + 24 * (resposta.count("\n") + (len(resposta) // 60) + 1))
      nova_altura = max(nova_altura, 150)

      janela.geometry(f"{largura}x{nova_altura}+{x}+{y}")
      desenhar(nova_altura)
      canvas.coords(entrada_id, (largura - 80) // 2, 32)
      canvas.coords(
   mic_oval,
   botao_x - botao_raio,
   botao_y - botao_raio,
   botao_x + botao_raio,
   botao_y + botao_raio
)
      canvas.coords(mic_texto_id, botao_x, botao_y)

      if resposta_window_id is None:
          resposta_window_id = canvas.create_window(
             largura // 2, (nova_altura + 60) // 2,
             window=frame_resposta, width=largura - 50, height=nova_altura - 70
          )

      else:
          canvas.coords(resposta_window_id, largura // 2, (nova_altura + 60) // 2)
          canvas.itemconfig(resposta_window_id, height=nova_altura - 70)

      digitar_texto(resposta)

   def processar_async(comando):
      resposta = orq.processar(comando)
      janela.after(0, lambda: mostrar_resposta(resposta))

   def processar(event=None):
      comando = entrada.get().strip()
      if not comando or comando == PLACEHOLDER or comando == "(nada detectado)":
          return

      entrada.config(state="disabled")
      threading.Thread(target=processar_async, args=(comando,), daemon=True).start()

   entrada.bind("<Return>", processar)
   entrada.bind("<Escape>", fechar)

   # Atalho de teclado pra ativar microfone: F2
   janela.bind("<F2>", lambda e: ao_clicar_mic())

   janela.mainloop()

def escutar_atalho():
   print("Noite pronta. Pressione Alt+Espaço para abrir.")
   print("Dica: dentro da janela, pressione F2 para usar o microfone.")
   keyboard.add_hotkey("alt+space", lambda: threading.Thread(target=abrir_janela).start())
   keyboard.wait()

if __name__ == "__main__":
   escutar_atalho()

