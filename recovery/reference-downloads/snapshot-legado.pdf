def limpar_query(query):
   """Remove verbo de busca que ficou colado no início da query"""
   return re.sub(r'^(pesquis\w*|busc\w*|procur\w*|toc\w*|most\w*)\s+', '', query,

flags=re.IGNORECASE).strip()

class Orchestrator:

 📂 def __init__(self):
      # Diretórios base
      self.base_dir = Path(__file__).parent.resolve()
      self.venv_dir = self.base_dir / ".venv"
  ⚙️# Configurações
      settings_path = self.base_dir / "config" / "settings.json"
      try:
          with open(settings_path, "r", encoding="utf-8") as f:
             self.settings = json.load(f)
      except Exception as e:
          print(f"[SETTINGS] Erro ao carregar settings.json: {e}")
          self.settings = {}

      self.debug = self.settings.get("debug", False)
      self.modelo_llm = self.settings.get("modelo", "llama3.2")

  📝# Carregar prompt uma única vez

      prompt_path = self.base_dir / "config" / "prompt.txt"
      try:

          with open(prompt_path, "r", encoding="utf-8") as f:
             self.prompt_base = f.read()

      except Exception as e:
          print(f"[PROMPT] Erro ao carregar prompt: {e}")
          self.prompt_base = "Você é uma assistente virtual útil."

  📝# Sistema de Logs

      self.log_ativo = self.settings.get("logs", {}).get("ativo", True)
      self.log_file = self.base_dir / "data" / "logs.log"
      self.log_file.parent.mkdir(parents=True, exist_ok=True)

  🤖# Inicialização dos Agentes

      self.system_agent = SystemAgent()
      self.calendar_agent = CalendarAgent()
      self.memory_agent = MemoryAgent()
      self.filesystem_agent = FilesystemAgent(self.base_dir)
      self.indexer_agent = IndexerAgent(self.base_dir)

  📜# Histórico e Cache

      self.historico = []
      self.cache_arquivos = None
      self.cache = OrderedDict()
      self.MAX_CACHE = self.settings.get("cache_max", 100)
self.CACHE_BLOQUEADO = {
   "listar_eventos", "pesquisar", "abrir", "reindexar",
   "listar_arquivos", "ler_arquivo", "abrir_arquivo"

}

⚡# Comandos diretos integrados

self.comandos_diretos = [
   {"nome": "google", "handler": self._cmd_google},
   {"nome": "youtube", "handler": self._cmd_youtube},
   {"nome": "spotify", "handler": self._cmd_spotify},
   {"nome": "steam", "handler": self._cmd_steam},
