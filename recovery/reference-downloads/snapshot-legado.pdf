   "criar_evento": lambda d: self.calendar_agent.criar_evento(d["descricao"], d["data_hora"]),
   "listar_eventos": lambda d: self.calendar_agent.listar_eventos(),
   "lembrar": lambda d: self.memory_agent.lembrar(d["fato"], d.get("permanente", False)),
   "listar_arquivos": lambda d: self.filesystem_agent.listar(d.get("caminho", "."), d.get("extensao")),
   "ler_arquivo": lambda d: self.filesystem_agent.ler(d["caminho"]),
   "buscar_arquivo": self._acao_buscar_arquivo,
   "abrir_arquivo": lambda d: self.filesystem_agent.abrir_arquivo(d["caminho"]),
   "reindexar": lambda d: self._indexar_e_retornar()

}

self._verificar_indexacao_inicial()

def _log(self, texto):
   print(texto)
   if self.log_ativo:
      try:
          with open(self.log_file, "a", encoding="utf-8") as f:
             timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
             f.write(f"[{timestamp}] {texto}\n")
      except Exception:
          pass

