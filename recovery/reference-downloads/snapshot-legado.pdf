FONTE_RESPOSTA = ("Segoe UI", 11)
FONTE_MIC = ("Segoe UI Symbol", 14, "bold")

# ===== CORRETOR FONÉTICO =====
def corrigir_palavra(palavra):

   if not palavra:
      return palavra

   p = palavra.strip(".,!?;:")
   p_lower = p.lower()

   if re.match(r'^(abr|avr|abri|abriu|abril|abirr|abrí)', p_lower):
      return "abra" if not p_lower.endswith(("r", "iu")) else "abrir"

   if re.match(r'^(pesqui|pesquise|pesquisa|pesquis|pesquiss|peski|peskisa|pezquisa|pequisa|peskiza|puxa)',
p_lower):

      return "pesquise"
   if re.match(r'^(prokur|procure|procura|procu|prócura)', p_lower):

      return "procure"
   if re.match(r'^(busk|busca|busque|buski|buc|búusca)', p_lower):

      return "busca"
   if re.match(r'^(tok|toca|toke|tocar|tóca)', p_lower):

      return "toca"
   if re.match(r'^(iutub|ioutube|youtub|youtube|yutub|yatube|ióutube|rútube|rutube|yt)', p_lower):

      return "youtube"
   if re.match(r'^(gugol|gogle|googl|gooogle|guugel|gúgou)', p_lower):
      return "google"

   if re.match(r'^(list|lista|liste|listar|lísta)', p_lower):
      return "lista"

   if re.match(r'^(mostr|mostra|moste|mostre|móstra)', p_lower):
      return "mostra"

   if re.match(r'^(marc|marca|marque|márca)', p_lower):
      return "marque"

   if re.match(r'^(ajend|agend|agende|ajende|ajénda)', p_lower):
      return "agende"

   if re.match(r'^(lembr|lembre|lembra|lémbre|lemb|lémbra)', p_lower):
      return "lembre"

   if re.match(r'^(anota|anot|anote|anóta)', p_lower):
      return "anota"

   if re.match(r'^(guard|guarda|guarde|guárda)', p_lower):
      return "guarda"

   if re.match(r'^(crom|krom|cromo|croma|cróma)', p_lower):
      return "chroma"

   if re.match(r'^(arki|arqui|arquiv|arkivo|arquivo|árquivo)', p_lower):
      return "arquivo"

   if re.match(r'^(comput|computad|pc|piq)', p_lower):
      return "computador"

   if p_lower in ["noites", "noytes", "noiti"]:
      return "noite"

   if re.match(r'^(diskord|discor|discórd|discod|diskor|discordia|discórdia|díscord)', p_lower):
      return "discord"

   if re.match(r'^(spotifai|spotifi|espotify|spotfy|esporte)', p_lower):
      return "spotify"

   if re.match(r'^(fech|fecha|feche|fechar|fexa|fexa)', p_lower):
      return "fechar"

   if re.match(r'^(ligar|liga|liqar|lígar|ligue)', p_lower):
      return "ligar"

   if re.match(r'^(desliga|desligar|dezliga|desli|desligae)', p_lower):
      return "desligar"

   if re.match(r'^(whatsapp|zap|uatsap|uatsapp|watsap|watsapp|uatzap)', p_lower):
      return "whatsapp"

   if re.match(r'^(gmail|gmeil|guimeil|gamal)', p_lower):
      return "gmail"

   if re.match(r'^(waze|uaze|uáze)', p_lower):
      return "waze"

   if re.match(r'^(maps|mapa|mapss|mape)', p_lower):
      return "maps"

   return p

def corrigir_texto(texto):
   if not texto:
      return texto
   palavras = texto.split()
   corrigidas = []
   for palavra in palavras:
      pontuacao = ""
      p_limpa = palavra
      if p_limpa and p_limpa[-1] in ".,!?;:":
          pontuacao = p_limpa[-1]
          p_limpa = p_limpa[:-1]
      corrigida = corrigir_palavra(p_limpa)
      corrigidas.append(corrigida + pontuacao)
   return ' '.join(corrigidas)
def extrair_comando(texto):
   """Remove a wake word e retorna o resto"""
   texto = texto.lower().strip()
   for palavra in PALAVRAS_ATIVACAO:
      if palavra in texto:
          partes = texto.split(palavra, 1)
          return partes[1].strip() if len(partes) > 1 else ""
   return texto

def rounded_rect(canvas, x1, y1, x2, y2, raio=22, **kwargs):
   pontos = [
      x1 + raio, y1, x2 - raio, y1, x2, y1, x2, y1 + raio,
      x2, y2 - raio, x2, y2, x2 - raio, y2, x1 + raio, y2,
      x1, y2, x1, y2 - raio, x1, y1 + raio, x1, y1,
   ]
   return canvas.create_polygon(pontos, smooth=True, **kwargs)

# ===== ESTADO GLOBAL DA JANELA (compartilhado entre voz e interface) =====
janela_atual = {"win": None, "mostrar_resposta": None, "abrir": None}

def abrir_janela():
   if janela_atual["win"] is not None:
      try:
          janela_atual["win"].lift()
          janela_atual["win"].focus_force()
          return
      except Exception:
          pass

   janela = tk.Tk()
   janela.title("")
   janela.overrideredirect(True)
   janela.attributes("-topmost", True)
   janela.configure(bg=COR_TRANSPARENTE)
   janela.attributes("-transparentcolor", COR_TRANSPARENTE)

   largura = 620
   altura_atual = 64
   altura_max = 420
   x = (janela.winfo_screenwidth() // 2) - (largura // 2)
   y = janela.winfo_screenheight() - 460

   janela.geometry(f"{largura}x{altura_atual}+{x}+{y}")

   canvas = tk.Canvas(janela, width=largura, height=altura_atual,
                    bg=COR_TRANSPARENTE, highlightthickness=0)

   canvas.pack(fill="both", expand=True)

   def desenhar(altura):
      canvas.delete("fundo")
      canvas.config(height=altura)
      rounded_rect(canvas, 2, 2, largura - 2, altura - 2,
                  raio=22, fill=COR_FUNDO, outline="", tags="fundo")
      canvas.tag_lower("fundo")

   desenhar(altura_atual)
# ===== DRAG DA JANELA =====
_drag_data = {"x": 0, "y": 0}

def iniciar_drag(event):
   _drag_data["x"] = event.x
   _drag_data["y"] = event.y

def arrastar(event):
   novo_x = janela.winfo_x() + (event.x - _drag_data["x"])
   novo_y = janela.winfo_y() + (event.y - _drag_data["y"])
   janela.geometry(f"+{novo_x}+{novo_y}")

canvas.bind("<ButtonPress-1>", iniciar_drag)
canvas.bind("<B1-Motion>", arrastar)

