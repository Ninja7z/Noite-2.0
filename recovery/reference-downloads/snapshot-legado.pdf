import time
import re
import sounddevice as sd
from vosk import Model, KaldiRecognizer
from orchestrator import Orchestrator

orq = Orchestrator()

# ===== CONFIGURAÇÕES DE VOZ =====
SAMPLE_RATE = 16000
PALAVRAS_ATIVACAO = ["mote", "moite", "noite", "monte", "note", "ativar",

                 "boa noite", "olá note", "ei note", "oi note"]

try:
   modelo_vosk = Model("model")
   VOSK_OK = True
