def digitar_texto(texto, indice=0):
   if indice == 0:
      texto_resposta.config(state="normal")
      texto_resposta.delete("1.0", "end")

   if indice < len(texto):
      texto_resposta.insert("end", texto[indice])
      texto_resposta.see("end")
      janela.after(15, lambda: digitar_texto(texto, indice + 1))

   else:
      texto_resposta.config(state="disabled")
      entrada.config(state="normal")
      entrada.delete(0, "end")
      entrada.focus_force()

def mostrar_resposta(resposta):
   nonlocal resposta_window_id
   nova_altura = min(altura_max, 90 + 24 * (resposta.count("\n") + (len(resposta) // 60) + 1))
   nova_altura = max(nova_altura, 150)

   janela.geometry(f"{largura}x{nova_altura}+{x}+{y}")
   desenhar(nova_altura)
   canvas.coords(entrada_id, (largura - 80) // 2, 32)
   canvas.coords(

      mic_oval,
   botao_x - botao_raio, botao_y - botao_raio,
   botao_x + botao_raio, botao_y + botao_raio
)
canvas.coords(mic_texto_id, botao_x, botao_y)

if resposta_window_id is None:
   resposta_window_id = canvas.create_window(
      largura // 2, (nova_altura + 60) // 2,
      window=frame_resposta, width=largura - 50, height=nova_altura - 70
   )

else:
   canvas.coords(resposta_window_id, largura // 2, (nova_altura + 60) // 2)
   canvas.itemconfig(resposta_window_id, height=nova_altura - 70)

digitar_texto(resposta)

def processar_async(comando):
   resposta = orq.processar(comando)
   janela.after(0, lambda: mostrar_resposta(resposta))

def processar(event=None):
   comando = entrada.get().strip()
   if not comando or comando == PLACEHOLDER or comando in ("(nada detectado)", "Ouvindo..."):
      return

entrada.config(state="disabled")
threading.Thread(target=processar_async, args=(comando,), daemon=True).start()

entrada.bind("<Return>", processar)
entrada.bind("<Escape>", fechar)
janela.bind("<F2>", lambda e: ao_clicar_mic())

# Registra no estado global pra voz poder usar              daemon=True).start()
janela_atual["win"] = janela
janela_atual["mostrar_resposta"] = mostrar_resposta
janela_atual["entrada"] = entrada
janela_atual["processar_comando"] = lambda texto: (

   entrada.config(state="normal"),
   entrada.delete(0, "end"),
   entrada.insert(0, texto),
   threading.Thread(target=processar_async, args=(texto,),
)

janela.protocol("WM_DELETE_WINDOW", fechar)
janela.mainloop()

# ===== ESCUTA DE VOZ EM BACKGROUND =====
def escutar_voz():

   if not VOSK_OK:
      print("[Voz] Vosk não disponível, microfone desativado.")
      return

   recognizer = KaldiRecognizer(modelo_vosk, SAMPLE_RATE)
   q = queue.Queue()

   def callback(indata, frames, time_info, status):
      q.put(bytes(indata))

   print("[Voz] Escutando em background... Diga 'Note' + comando para abrir a janela.")
   with sd.RawInputStream(samplerate=SAMPLE_RATE, blocksize=8000, dtype='int16',
                       channels=1, callback=callback):

      while True:
          try:
             data = q.get(timeout=1)
          except queue.Empty:
             continue

          if recognizer.AcceptWaveform(data):
             try:
                resultado = json.loads(recognizer.Result())
                texto = resultado.get("text", "").strip().lower()
             except Exception:
                continue

             if not texto:
                continue

             texto_corrigido = corrigir_texto(texto)
             if texto_corrigido != texto:

                print(f"[Voz] Ouvido: {texto} -> Corrigido: {texto_corrigido}")
             else:

                print(f"[Voz] Ouvido: {texto_corrigido}")

             tem_wake = any(p in texto_corrigido for p in PALAVRAS_ATIVACAO)
             if not tem_wake:

                continue

             comando = extrair_comando(texto_corrigido)
             if not comando:

                continue

             print(f"[Voz] Comando: {comando}")

             def acionar():
                if janela_atual["win"] is None:
                    abrir_janela_em_thread_principal_pendente.append(comando)
                else:
                    janela_atual["processar_comando"](comando)

             acionar()

abrir_janela_em_thread_principal_pendente = []

def checar_pendentes_loop(root_dummy):
   if abrir_janela_em_thread_principal_pendente:
      comando = abrir_janela_em_thread_principal_pendente.pop(0)
      abrir_janela()
      if janela_atual.get("processar_comando"):
          janela_atual["processar_comando"](comando)
   root_dummy.after(200, lambda: checar_pendentes_loop(root_dummy))

def main():
   print(">" * 50)
   print(" NOTE - Assistente Pessoal")
   print("<" * 50)
   print("Alt + Espaço para abrir a interface.")
   print("Diga 'Note' Abrir para usar por voz.")
   print("Dentro da janela, F2 ativa o microfone manual.")
   print("~" * 50)

   keyboard.add_hotkey("alt+space", lambda: threading.Thread(target=abrir_janela, daemon=True).start())

   threading.Thread(target=escutar_voz, daemon=True).start()

   root = tk.Tk()
   root.withdraw()
   checar_pendentes_loop(root)
   root.mainloop()

if __name__ == "__main__":
   main()

