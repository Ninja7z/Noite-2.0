canvas.tag_bind("mic", "<Leave>", ao_sair_mic)

if VOSK_OK:
   desenhar_mic(COR_MIC_NORMAL)

else:
   desenhar_mic("#555555")

# ===== GRAVAÇÃO MANUAL (F2 / clique no mic) - stream próprio =====
def gravar_audio_manual():

   """Grava até 8s ou até clicar de novo / 2s de silêncio"""
   recognizer_local = KaldiRecognizer(modelo_vosk, SAMPLE_RATE)
   audio_q = queue.Queue()

   def cb(indata, frames, time_info, status):
      audio_q.put(bytes(indata))

   texto_final = ""
   inicio = time.time()
   silencio_inicio = None
   TEMPO_MAX = 10.0
   SILENCIO_FIM = 1.3

   with sd.RawInputStream(samplerate=SAMPLE_RATE, blocksize=8000, dtype='int16',
                       channels=1, callback=cb):

      while gravando_manual[0] and (time.time() - inicio) < TEMPO_MAX:
          try:
             data = audio_q.get(timeout=0.1)
          except queue.Empty:
             continue

          if recognizer_local.AcceptWaveform(data):
             resultado = json.loads(recognizer_local.Result())
             fragmento = resultado.get("text", "").strip()
             if fragmento:
                texto_final = fragmento
                silencio_inicio = None

          else:
             parcial = json.loads(recognizer_local.PartialResult())
             if not parcial.get("partial", "").strip():
                if silencio_inicio is None:
                    silencio_inicio = time.time()
                elif time.time() - silencio_inicio > SILENCIO_FIM:
                    break
             else:
                silencio_inicio = None

   resultado = json.loads(recognizer_local.FinalResult())
   if resultado.get("text", "").strip():

      texto_final = resultado["text"].strip()

   return texto_final

def iniciar_gravacao_manual():
   gravando_manual[0] = True
   desenhar_mic(COR_MIC_GRAVANDO)
   entrada.config(state="normal")
   if entrada.get() == PLACEHOLDER:
      entrada.delete(0, "end")
      entrada.config(fg=COR_TEXTO)
   entrada.delete(0, "end")
   entrada.insert(0, "Ouvindo...")

   def worker():
      texto = gravar_audio_manual()
      janela.after(0, lambda: finalizar_gravacao_manual(texto))

   threading.Thread(target=worker, daemon=True).start()

def finalizar_gravacao_manual(texto):
   gravando_manual[0] = False
   processando_audio[0] = True
   desenhar_mic(COR_MIC_PROCESSANDO)

   entrada.delete(0, "end")

   if texto:
      texto_corrigido = corrigir_texto(texto.lower())
      print(f"[Mic Manual] Original: {texto} -> Corrigido: {texto_corrigido}")
      entrada.insert(0, texto_corrigido)
      entrada.config(fg=COR_TEXTO)
      entrada.focus_force()

   else:
      entrada.insert(0, PLACEHOLDER)
      entrada.config(fg=COR_PLACEHOLDER)

   janela.after(400, voltar_mic_normal)

def voltar_mic_normal():
   processando_audio[0] = False
   if VOSK_OK:

      desenhar_mic(COR_MIC_NORMAL)
   else:

      desenhar_mic("#555555")

