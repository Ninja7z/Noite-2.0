   )

def ao_clicar_mic(event=None):
   if not mic_ativo[0] or processando_audio[0]:
      return
   if not gravando_manual[0]:
      iniciar_gravacao_manual()
   else:
      gravando_manual[0] = False

def ao_passar_mic(event=None):
