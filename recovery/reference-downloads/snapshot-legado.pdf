          self._log(f"[Indexador] {stats.get('total_documentos', 0)} documentos
   except Exception as e:
      self._log(f"[Indexador] Erro: {e}")

def _indexar_e_retornar(self):
   self.indexar_tudo()
   return "Arquivos reindexados."

def indexar_tudo(self):
   self._log("[Indexador] Iniciando processo de indexação...")
   def _executar():
      return self.indexer_agent.index_all()
   try:
      with concurrent.futures.ThreadPoolExecutor() as executor:
          future = executor.submit(_executar)
          count = future.result(timeout=15)
      self._log(f"[Indexador] {count} arquivos indexados.")

   except concurrent.futures.TimeoutError:
      self._log("[Indexador] Tempo limite excedido. A indexação foi abortada para não travar a IA.")

   except Exception as e:
      self._log(f"[Indexador] Erro ao indexar: {e}")

# --- Normalização e Extração ---
def _normalizar_comando(self, cmd):

   return cmd.lower().strip()

def _extrair_termo_busca(self, cmd, plataforma):
   cmd = cmd.replace(plataforma, "")
   cmd = re.sub(r"\b(pesquise|pesquisa|procure|busque)\b", "", cmd)
   cmd = re.sub(r"\b(no|na|por|o|a)\b", "", cmd)
   return cmd.strip()

# --- Handlers de Comandos Diretos ---
def _cmd_google(self, cmd):

   termo = self._extrair_termo_busca(cmd, "google")
   if not termo:

      return "O que você deseja pesquisar no Google?"
   return self.system_agent.pesquisar("google", termo)

def _cmd_youtube(self, cmd):
   termo = self._extrair_termo_busca(cmd, "youtube")
   if not termo:
      return "O que você deseja pesquisar no YouTube?"
   return self.system_agent.pesquisar("youtube", termo)

def _cmd_spotify(self, cmd):
   termo = self._extrair_termo_busca(cmd, "spotify")
   if not termo:
      return self.system_agent.abrir("spotify")
   return self.system_agent.abrir(f"https://open.spotify.com/search/{termo}")

def _cmd_steam(self, cmd):
   termo = self._extrair_termo_busca(cmd, "steam")
   if not termo:
      return self.system_agent.abrir("steam")
   return self.system_agent.abrir(f"steam://store/search/?term={termo}")

def _cmd_discord(self, cmd):
   return self.system_agent.abrir("discord")

def _fallback_roteador(self, cmd):
   # 1. Se tiver intenção de pesquisa junto, NÃO usa o roteador rápido
   # (deixa pra _detectar_acao_rapida, que sabe separar site + query)
   tem_pesquisa = re.search(r'\b(pesquise|pesquisa|pesquisar|procure|procura|busca|busque)\b', cmd)
   if tem_pesquisa:
      return None

   # 2. Prioridade: Intenção de abrir aplicativos ou sites (sem pesquisa)
   if cmd.startswith("abra "):

      alvo = cmd[5:].strip()
      alvo = re.sub(r'^(e|ou)\s+', '', alvo).strip()
          if alvo:
             return self.system_agent.abrir(alvo)

      # 3. Comandos de pesquisa específicos diretos (ex: "youtube", "spotify")
      for comando in self.comandos_diretos:

          nome = comando["nome"]
          if re.search(rf"\b{nome}\b", cmd):

             return comando["handler"](cmd)

      return None

      # 2. Prioridade Secundária: Comandos de pesquisa específicos
      for comando in self.comandos_diretos:

          nome = comando["nome"]
          if re.search(rf"\b{nome}\b", cmd):

             return comando["handler"](cmd)

      return None

   # --- Detecção de Ação por Regex (intenções complexas) ---
   def _detectar_acao_rapida(self, cmd):

      """Detecta ações estruturadas (pesquisar com site, eventos, memória, arquivos) via regex"""
      try:

          cmd = re.sub(r'\b(por favor|pra mim|ai|ái|pfv)\b', '', cmd).strip()

          # "pesquise X no youtube/google"
          match = re.search(r'(?:pesquise|pesquisa|pesquisar|procure|procura|busca|busque|toca|tocar|me
mostra)\s+(?:por|sobre)?\s*(.+?)\s+no\s+(youtube|google)\b', cmd)
          if match:

             query = match.group(1).strip()
             site = match.group(2).strip()
             query = re.sub(r'\s+(pra mim|por favor|ai|ái)$', '', query).strip()
             query = limpar_query(query)
             if query and site in ["youtube", "google"]:

                return {"acao": "pesquisar", "site": site, "query": query}

          # "no youtube pesquise X", "no youtube X"
          match =
re.search(r'no\s+(youtube|google)\s+(?:pesquise|pesquisa|pesquisar|procure|procura|busca|busque|toca)?\s
*(?:por|sobre)?\s*(.+)', cmd)
          if match:

             site = match.group(1).strip()
             query = match.group(2).strip()
             query = re.sub(r'\s+(pra mim|por favor|ai|ái)$', '', query).strip()
             query = limpar_query(query)
             if query:

                return {"acao": "pesquisar", "site": site, "query": query}

          # "youtube pesquise X" ou "youtube X"
          match =
re.search(r'(youtube|google)\s+(?:pesquise|pesquisa|pesquisar|procure|procura|busca|busque|toca|me
mostra)?\s*(?:por|sobre)?\s*(.+)', cmd)
          if match:

             site = match.group(1).strip()
             query = match.group(2).strip()
             query = re.sub(r'\s+(pra mim|por favor|ai|ái)$', '', query).strip()
             query = limpar_query(query)
             if query:

                return {"acao": "pesquisar", "site": site, "query": query}
          # Pesquisar local (PC)
          match =
re.search(r'\b(pesquise|pesquisa|busca|procura)\s+(?:nos\s+|no\s+)?(?:meus\s+)?(?:arquivos?|pc|computad
or)\s+(.+)', cmd)
          if match:

             query = match.group(2).strip()
             query = limpar_query(query)
             if query:

                return {"acao": "pesquisar", "site": "local", "query": query}

          # Abrir arquivo específico (com extensão)
          match = re.search(r'\b(abre|abrir|abre o)\s+(?:o\s+)?(?:arquivo\s+)?([\w\-./\\]+\.\w+)', cmd)
          if match:

             caminho = match.group(2).strip()
             if '/' in caminho or '\\' in caminho or caminho.endswith(('.py', '.txt', '.md', '.json', '.csv', '.pdf', '.docx',
'.xlsx', '.html', '.js', '.css', '.ipynb')):

                return {"acao": "abrir_arquivo", "caminho": caminho}

          # Pesquisar padrão (google)
          match =
re.search(r'\b(pesquise|pesquisa|pesquisar|procure|procura|busca|busque)\s+(?:por|sobre)?\s*(.+)', cmd)
          if match:

             query = match.group(2).strip()
             query = re.sub(r'\s+(pra mim|por favor|ai|ái|no youtube|no google)$', '', query).strip()
             query = limpar_query(query)
             if query and not query.startswith("arquivo"):

                return {"acao": "pesquisar", "site": "google", "query": query}

          # Buscar arquivo
          match = re.search(r'\b(busca|procure|procura|encontra|acha)\s+(?:arquivo\s+)?(?:sobre|de|com|que
tenha|com tema|sobre)\s+(.+)', cmd)
          if match:

             query = match.group(2).strip()
             if query:

                return {"acao": "buscar_arquivo", "query": query}

          # Listar arquivos
          match = re.search(r'\b(lista|mostra|liste|mostre)\s+(?:os\s+)?(?:arquivos|pastas|arquivos da
pasta|arquivos do)(?:\s+(.+))?', cmd)
          if match:

             resto = (match.group(2) or "").strip()
             caminho = "."
             extensao = None
             caminho_match = re.search(r'(?:da pasta|de|do|em)\s+([\w/\\]+)', resto)
             if caminho_match:

                caminho = caminho_match.group(1).strip()
             ext_match = re.search(r'\.(py|txt|md|json|csv|pdf|docx?|xlsx?|html|js|css)$', resto)
             if ext_match:

                extensao = "." + ext_match.group(1)
             return {"acao": "listar_arquivos", "caminho": caminho, "extensao": extensao}

          # Marcar evento
          match = re.search(r'\b(marque|marca|agende|agendar|anota na agenda|coloca na agenda|cria um
evento)\s+(.+)', cmd)
          if match:

             return {"acao": "criar_evento", "descricao": match.group(2).strip(), "data_hora":
datetime.now().strftime("%Y-%m-%d %H:%M")}

          # Lembrar
          match = re.search(r'\b(lembre|lembrar|lembra|anota|guarda|salva)\s+(.+)', cmd)
          if match:
             fato = match.group(2).strip()
             permanente = any(p in cmd for p in ["para sempre", "nunca esqueça", "sempre", "permanente"])
             return {"acao": "lembrar", "fato": fato, "permanente": permanente}

          # Listar eventos
          if re.search(r'\b(o que (tenho|tenho marcado|tá marcado|esta marcado)|meus eventos|minha
agenda|o que tem marcado)\b', cmd):

             return {"acao": "listar_eventos"}

          # Reindexar
          if re.search(r'\b(reindexa|indexa|reindexar|indexar)\b', cmd):

             return {"acao": "reindexar"}

          return None
      except Exception as e:

          self._log(f"[ERRO _detectar_acao_rapida] {e}")
          return None

   # --- Fluxo Principal ---
   def processar(self, comando, modo=None):

      t_inicio = time.time()
      cmd_clean = self._normalizar_comando(comando)

      if not cmd_clean:
          return "Diga alguma coisa!"

      self._log(f"\n[COMANDO] {comando}")

      # 1. Roteador rápido (comandos diretos simples: "abra X", nome de app, etc.)
      resultado_direto = self._fallback_roteador(cmd_clean)
      if resultado_direto:

          self._log(f"[TEMPO] Execução Direta: {time.time() - t_inicio:.2f}s")
          return resultado_direto

      # 2. Detecção de ação por regex (pesquisar com site, eventos, memória, arquivos)
      acao_detectada = self._detectar_acao_rapida(cmd_clean)
      if acao_detectada:

          self._log(f"[AÇÃO REGEX] {acao_detectada}")
          handler = self.executores_acoes.get(acao_detectada.get("acao"))
          if handler:

             resultado = handler(acao_detectada)
             self._log(f"[TEMPO] Execução Regex: {time.time() - t_inicio:.2f}s")
             return resultado

      cache_ativo = self.settings.get("cache_ativo", True)

      if cache_ativo and cmd_clean in self.cache:
          self._log(f"[CACHE HIT] Reaproveitando resposta para: '{cmd_clean}'")
          self._log(f"[TEMPO] Resposta Cache: {time.time() - t_inicio:.2f}s")
          return self.cache[cmd_clean]

      system_prompt = self._montar_system_prompt(comando)
      self.historico.append({"role": "user", "content": comando})

      try:
          resposta = ollama.chat(
             model=self.modelo_llm,
             messages=[{"role": "system", "content": system_prompt}] + self.historico
          )
      texto = resposta["message"]["content"].strip()
   except Exception as e:

      self._log(f"[ERRO LLM] {e}")
      return f"Erro ao consultar o modelo: {e}"

   self._log(f"[LLAMA] {texto}")

   resultado_acao, acao_detectada_json = self._tentar_acao(texto)

   if resultado_acao:
      if acao_detectada_json not in ("abrir", "pesquisar", "abrir_arquivo", "reindexar"):
          self.historico.append({"role": "assistant", "content": resultado_acao})

      if cache_ativo and acao_detectada_json not in self.CACHE_BLOQUEADO:
          self._salvar_no_cache(cmd_clean, resultado_acao)

      self._limpar_historico_velho()
      self._log(f"[TEMPO] Total (Ação): {time.time() - t_inicio:.2f}s")
      return resultado_acao

   self.historico.append({"role": "assistant", "content": texto})
   if cache_ativo:

      self._salvar_no_cache(cmd_clean, texto)
   self._limpar_historico_velho()

   self._log(f"[TEMPO] Total (Conversa): {time.time() - t_inicio:.2f}s")
   return texto

def _salvar_no_cache(self, chave, valor):
   if chave in self.cache:
      self.cache.move_to_end(chave)
   self.cache[chave] = valor
   if len(self.cache) > self.MAX_CACHE:
      self.cache.popitem(last=False)

def _limpar_historico_velho(self):
   limite = self.settings.get("historico_max", 20)
   if len(self.historico) > limite:
      self.historico = self.historico[-limite:]

def _montar_system_prompt(self, comando):
   base = self.prompt_base
   hoje = datetime.now().strftime("%Y-%m-%d (%A)")
   fatos = self.memory_agent.buscar_relevantes(comando)

   contexto_arquivos = ""
   try:

      docs_relevantes = self.indexer_agent.buscar(comando, n_results=3)
      if docs_relevantes:

          contexto_arquivos = "\n\nArquivos relevantes encontrados:\n"
          for doc in docs_relevantes:

             contexto_arquivos += f"- {doc.get('caminho', '?')}: {doc.get('preview', '')[:100]}\n"
   except Exception:

      pass

   extra = f"\n\nHoje é {hoje}."
   if fatos:

      extra += f"\n\nMemórias: {fatos}"
   if contexto_arquivos:

      extra += contexto_arquivos
      return base + extra

   # --- Executores de Ações ---
   def _acao_abrir(self, dados):

      alvo = dados["alvo"]
      if self.filesystem_agent.existe(alvo):

          return self.filesystem_agent.abrir_arquivo(alvo)
      return self.system_agent.abrir(alvo)

   def _acao_pesquisar(self, dados):
      site = dados["site"]
      query = dados["query"]
      if site in ("local", "arquivos", "pc"):
          resultados = self.indexer_agent.buscar(query, n_results=10)
          return self.filesystem_agent.formatar_resultados(query, resultados)
      return self.system_agent.pesquisar(site, query)

   def _acao_buscar_arquivo(self, dados):
      resultados = self.indexer_agent.buscar(dados["query"], n_results=10)
      return self.filesystem_agent.formatar_resultados(dados["query"], resultados)

   def _tentar_acao(self, texto):
      try:
          limpo = texto.replace("```json", "").replace("```", "").strip()
          inicio = limpo.find("{")
          fim = limpo.rfind("}")

          if inicio == -1 or fim == -1:
             return None, None

          json_texto = limpo[inicio:fim+1]
          dados = json.loads(json_texto)
          acao = dados.get("acao")

          if not acao:
             return None, None

          self._log(f"[AÇÃO] Executando: {acao} -> {dados}")

          handler = self.executores_acoes.get(acao)
          if handler:

             return handler(dados), acao

      except Exception as e:
          self._log(f"[ERRO AÇÃO] Falha ao processar comando estruturado: {e}")
          return f"Erro na execução da ação: {e}", None

      return None, None
import json
